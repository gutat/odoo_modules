<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_odd" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.odd</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- Place totals in header -->
            <xpath expr="//field[@name='origin']" position="after">
                <field name="total_box_count" readonly="1" string="Total Boxes"/>
            </xpath>
            <!-- Add Box and Bag counts to lines -->
            <xpath expr="//field[@name='move_ids_without_package']/tree/field[@name='product_uom_qty']" position="before">
                <field name="box_count" string="Box" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
